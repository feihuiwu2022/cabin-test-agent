# CabinPilot 台架 Agent 环境变量模板。这里不放模型凭证，判定和模型调用都走云端。
# 使用：cp .env.example .env，然后填写。优先级：进程环境变量 > 本目录（打包后为 exe 旁边）的 .env > 数据目录的 agent.json
# 打包成 exe 的台架一般不用 .env：首次启动在本地页面填云端地址和注册码，保存到 %LOCALAPPDATA%\CabinPilot\agent\agent.json

# 云端地址（必填）
CABIN_CLOUD_URL=http://云端地址:8800

# 本台架
CABIN_RIG_ID=B1
CABIN_RIG_MODEL=A01-CN
# 只有首次注册需要；注册后令牌保存在数据目录
CABIN_RIG_REGISTER_CODE=

# 车机：adb（真实台架）| simcar（模拟车机）
CABIN_DEVICE=adb
CABIN_ADB_SERIAL=

# 车机上存放日志包的目录（失败时 adb pull 最新的一个），例：/data/log/cabin
CABIN_LOG_DIR=

# 本地页面端口，只监听 127.0.0.1
CABIN_UI_PORT=8810
