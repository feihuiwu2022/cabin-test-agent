# CabinPilot 云端环境变量模板（台架 Agent 的模板见 apps/agent/.env.example）
# 使用：cp .env.example .env，然后填入真实凭证。.env 已被 .gitignore 排除，不会提交。
#
# 优先级：进程环境变量 > 根目录 .env

# ---------- 模型网关（必填）----------
# MiniMax 的 Anthropic 兼容接口，在控制台获取
CABIN_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
CABIN_LLM_BASE_URL=https://api.minimaxi.com/anthropic

# 对话 / 视觉模型名
CABIN_CHAT_MODEL=MiniMax-M3
CABIN_VISION_MODEL=MiniMax-M3

# ---------- 界面标识 ----------
# 右上角顶栏显示的版本标识
CABIN_VERSION_LABEL=开源演示

    # 顶栏版本标识
    CABIN_VERSION_LABEL=开源演示

# ---------- 语音 ----------
CABIN_TTS_MODEL=speech-2.8-turbo
CABIN_TTS_VOICE=female-shaonv

# ---------- 登录 ----------
# feishu：飞书网页授权（需 FEISHU_APP_ID/SECRET，并把 <CABIN_PUBLIC_URL>/api/v1/auth/feishu/callback 配为重定向地址）
# lan：局域网部署且没有飞书应用时用：填姓名 + 团队口令登录（见 docs/DEPLOY_LAN.md）
# dev：不接飞书，直接以 CABIN_DEV_USER 登录，只用于本地调试
CABIN_AUTH_MODE=feishu
CABIN_DEV_USER=测试工程师
# lan 登录的团队口令（必填）和允许的姓名（逗号分隔；留空则任何姓名凭口令都能登录）
CABIN_LAN_PASSCODE=
CABIN_LAN_USERS=

# 加密云端保管的凭证（Jira 服务账号），换掉后要重新填写
CABIN_SECRET_KEY=
# 能改 Jira 公共配置的人，飞书姓名，逗号分隔
CABIN_ADMINS=

# ---------- 台架 ----------
# 台架注册码：Agent 首次注册时提交。留空则拒绝一切新台架注册
CABIN_RIG_REGISTER_CODE=
# 默认台架：语音下达没指定台架时用它
CABIN_RIG_ID=B2
# 默认台架的车型代码：A01-CN / A01-INTL / B01-EU / D01 / E01
CABIN_RIG_MODEL=A01-CN
# 被测应用包名（生成触屏测试代码时作起点）：设置=包名;空调=包名。AAOS 模拟器的设置是 com.android.car.settings
# CABIN_APP_PACKAGES=设置=com.android.car.settings

# ---------- 服务 ----------
# 给同一 Wi-Fi / 局域网的同事用：CABIN_HOST=0.0.0.0，CABIN_PUBLIC_URL 写本机局域网地址（如 http://192.168.1.23:8800）
CABIN_HOST=127.0.0.1
CABIN_PORT=8800
CABIN_PUBLIC_URL=http://127.0.0.1:8800

# ---------- Jira（可选，留空用本地沙箱）----------
JIRA_URL=
JIRA_USER=
JIRA_PASSWORD=
JIRA_PROJECT=CTRTS

# ---------- 飞书（可选，留空用界面内模拟卡片）----------
FEISHU_WEBHOOK=
# 每日回归汇总的时间；定时和汇总按这个时区算（小时偏移），容器的系统时区通常是 UTC
CABIN_DIGEST_AT=08:30
CABIN_TZ_HOURS=8
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CASE_DOC=
# 上传的 Word PRD 先转成飞书文档放进这个云空间文件夹（填文件夹链接或 token），之后以飞书文档为准；为空时 Word 在本地解析
# 应用需要该文件夹的编辑权限，并开通云文档导入权限（drive:drive）
FEISHU_PRD_FOLDER=
# 用例库多维表格（一期 A 用例主数据）：表格链接，形如 https://xxx.feishu.cn/base/<app_token>?table=<table_id>
# 需上面的 APP_ID/SECRET；应用开通“多维表格”读写权限，并在表格里把应用加为协作者（可编辑）
FEISHU_BITABLE_URL=
# 按模块分表 / 分文件夹在 backend/modules.yaml 配置（模块没配 bitable 就用上面的默认表）；可改路径
# CABIN_MODULES_FILE=backend/modules.yaml
# 多维表格 → CabinPilot 反向同步周期（秒）
CABIN_BITABLE_SYNC_S=300

# ---------- 数据合规 ----------
# 1：internal/sensitive 数据禁止走外网模型
CABIN_STRICT_DATA=0

# ---------- 其他 ----------
# 本机代理不稳时默认直连，设为 1 走环境代理
CABIN_USE_PROXY=0
